# Copy to .env and fill in. Never commit .env.

# Any OpenAI-compatible chat-completions endpoint with tool calling:
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://host.docker.internal:11434/v1   (key can be any non-empty string)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Linux only: run the runner as your user so ./runs is not owned by root.
BENCH_UID=1000
BENCH_GID=1000
